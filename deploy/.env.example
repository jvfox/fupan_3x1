# 部署模板：复制为项目 data/secrets.env（chmod 600，属主为运行用户）
# 所有 CHANGE_ME 占位值都必须替换；不要提交真实口令到 git。

# ---------- 管理后台 ----------
ADMIN_PATH=admin
ADMIN_USER=admin
ADMIN_PASSWORD=CHANGE_ME
# python -c "import secrets;print(secrets.token_hex(24))"
ADMIN_SECRET=CHANGE_ME_TO_RANDOM_STRING

# ---------- 安全开关（公网 HTTPS 部署固定如下）----------
SECURE_MODE=1
SECURE_COOKIE=1
TRUST_XFF=1

# ---------- 数据库（SQLite 起步，生产可切 MySQL）----------
DB_DRIVER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ashare
DB_PASSWORD=
DB_NAME=ashare_review

# ---------- 数据与采集 ----------
RECORDS_RECENT_DAYS=30
AUTO_BACKFILL_DAYS=15
HISTORY_DAYS=60
FULL_COLLECT_TIME=15:30
INTRADAY_POLL_MINUTES=1
INTRADAY_START=09:30
INTRADAY_END=15:00

# ---------- 限流保护 ----------
REQUEST_MIN_INTERVAL=1.2
MAX_RETRIES=3
RETRY_BACKOFF=5

# ---------- 服务 ----------
PORT=8000
LOG_LEVEL=INFO
ENABLE_SCHEDULER=1

# ---------- 可选第三方数据源 ----------
# 默认关闭开源版不需要任何密钥；自建服务时填写你自己的 Key 与域名
FUYAO_ENABLED=0
FUYAO_KEY=
FUYAO_BASE=https://fuyao.aicubes.cn
FUYAO_ALLOWED_HOST=fuyao.aicubes.cn
PRIMARY_SOURCE=akshare
