# 环境变量模板：复制为 data/secrets.env 后按实际填写
# 真实密钥只放在 data/secrets.env（已被 .gitignore 排除），切勿提交到版本库。
# 进程环境变量优先于本文件。

# ===== 必改（公网部署前）=====
# 管理后台路径，建议改成不易猜测的值（默认 admin）
ADMIN_PATH=admin
# 后台只有一个账号，无角色体系；用户名请自定义
ADMIN_USER=admin
# 用强口令；弱值 + SECURE_MODE=1 会直接拒绝启动
ADMIN_PASSWORD=CHANGE_ME
# 会话签名密钥，用 python -c "import secrets;print(secrets.token_hex(24))" 生成
ADMIN_SECRET=CHANGE_ME_TO_RANDOM_STRING

# ===== 安全开关 =====
SECURE_MODE=1
# HTTPS 部署设 1；纯本机 http 调试才设 0
SECURE_COOKIE=1
# 有可信反向代理且 nginx 用 X-Forwarded-For $remote_addr 覆盖时设 1
TRUST_XFF=1

# ===== 数据源 =====
# 开源版默认走公开源（AkShare + 新浪 + 腾讯），无需密钥。
# fuyao 是可选的第三方增强源；需要你自己的 API Key，未配置时保持关闭。
FUYAO_ENABLED=0
FUYAO_KEY=
FUYAO_BASE=https://fuyao.aicubes.cn
FUYAO_ALLOWED_HOST=fuyao.aicubes.cn
PRIMARY_SOURCE=akshare

# ===== 数据库（默认 SQLite，零依赖起步）=====
DB_DRIVER=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ashare
DB_PASSWORD=
DB_NAME=ashare_review

# ===== 数据与采集 =====
# 前端只保留最近 N 个交易日（默认 30）
RECORDS_RECENT_DAYS=30
# 种子文件缺失时首次启动自动回溯的交易日数；0 表示关闭
AUTO_BACKFILL_DAYS=15
HISTORY_DAYS=60
ENABLE_SCHEDULER=1
FULL_COLLECT_TIME=15:30
INTRADAY_POLL_MINUTES=1
INTRADAY_START=09:30
INTRADAY_END=15:00
